#!/usr/bin/env python3

import argparse
import sys

from arguments.template import template

imported: bool = True
try:
    from subcommands.deploy import deploy
    from subcommands.init import init
    from subcommands.rollback import rollback
    from subcommands.status import status
    from subcommands.watch import watch
except ImportError:
    imported = False


parser = argparse.ArgumentParser("tealflip")

parser.add_argument(
    "-t",
    "--template",
    action="store_true",
    help="Makes a copy of templates/ configuration variables",
)

if not imported:
    args = parser.parse_args()  # Placing parser call inside imported if statement so --help argument does not stop at this call and reads the next parser call
    if args.template:
        template()
        sys.exit(0)
    else:
        print("Configuration Variables Does Not Exist!")
        print("run: \033[48;5;238m./tealflip -t\033[0m")
        sys.exit(1)
else:
    pass

try:
    subparsers = parser.add_subparsers(
        title="subcommands",
        prog="tealflip",
        dest="subcommand",
        metavar="<subcommand>",
        required=False,
    )

    parser_init = subparsers.add_parser(
        "init",
        description="tealflip initialize",
        help="Initialize files and configurations",
    ).set_defaults(func=init)

    parser_status = subparsers.add_parser(
        "status",
        description="tealflip status",
        help="Displays idle/active slots commit hash",
    ).set_defaults(func=status)

    parser_deploy = subparsers.add_parser(
        "deploy",
        description="tealflip deploy",
        help="Deploys new commit version and switches to latest healthy commit",
    ).set_defaults(func=deploy)

    parser_rollback = subparsers.add_parser(
        "rollback",
        description="tealflip rollback",
        help="Rolls back to healthy idle slot",
    ).set_defaults(func=rollback)

    parser_watch = subparsers.add_parser(
        "watch",
        description="tealflip watch",
        help="Watches for latest remote git commits",
    ).set_defaults(func=watch)

except NameError:
    print("Missing subcommand import!")
    sys.exit(1)

args = parser.parse_args()

if len(sys.argv) == 1:
    parser.print_help()
    sys.exit(0)
elif args.template:
    print("config.py Already Exists in variables/ directory")
    sys.exit(0)
try:
    args.func()
except AttributeError:
    print("Bad subcommand function call!")
    sys.exit(1)
